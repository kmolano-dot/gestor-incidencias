# Database
POSTGRES_DB=gestor_incidencias
POSTGRES_USER=<<usuario de postgres>>
POSTGRES_PASSWORD=<<contraseña de postgres>>

# Flask / Conexión
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://<<POSTGRES_USER>>:<<POSTGRES_PASSWORD>>@db:5432/gestor_incidencias

# Jenkins
JENKINS_ADMIN_USER=<<usuario de jenkins>>
JENKINS_ADMIN_PASSWORD=<<contraseña de jenkins>>

# GitHub (el token es opcional si el repositorio es público)
GITHUB_REPO_URL=https://github.com/kmolano-dot/gestor-incidencias.git
GITHUB_BRANCH=main
GITHUB_USER=
GITHUB_TOKEN=
